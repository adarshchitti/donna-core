# Bright Data -- the sole fetch path for the whole system
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=
BRIGHTDATA_SERP_ZONE=

# live | record | replay   (defaults to replay, so a bare run spends nothing)
DONNA_FETCH_MODE=replay
# Hard stop well under the 300 credits available for the whole event
DONNA_CREDIT_CEILING=250

# MongoDB -- the same cluster and database Base44 (Track C) reads
MONGODB_URI=
MONGODB_DATABASE=Donna

# Which book the orchestrator serves. Every document we write carries this.
DONNA_BOOK_ID=

ANTHROPIC_API_KEY=
DAYTONA_API_KEY=
