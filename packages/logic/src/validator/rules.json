{
  "version": 1,
  "corroboration_window_days": 14,
  "thresholds": {
    "tier2_min_exposure_weight": 0.15,
    "tier3_pattern_count": 3,
    "reported_min_independent_outlets": 2,
    "_tier2_note": "Was 0.30, which suppressed the architecture's own worked example ($820k at 14% share scores 0.289) and every tier-2 signal on a mid-size deal. Calibrated so a $400k deal at 10% share (0.16) surfaces. Deals missing the optional fields bypass this gate entirely -- see surfaces() in cluster.ts."
  },
  "labels": {
    "reported_unconfirmed": "Reported and unconfirmed: no primary record has been observed yet."
  },
  "exposure": {
    "value_cap_usd": 2000000,
    "value_weight": 0.5,
    "share_cap_pct": 50,
    "share_weight": 0.3,
    "hard_substitutability_multiplier": 2,
    "notice_window_days": 90,
    "notice_window_bonus": 0.15,
    "weight_decimals": 2
  },
  "watch_terms": {
    "amount_fields": [
      "claim_amount_usd",
      "amount_usd",
      "claim_usd",
      "damages_usd",
      "value_usd"
    ],
    "name_fields": [
      "name",
      "person",
      "officer",
      "officer_name",
      "person_name"
    ],
    "key_person_types": [
      "exec_departure"
    ],
    "litigation_types": [
      "litigation"
    ],
    "change_of_control_types": [
      "change_of_control",
      "insolvency"
    ]
  },
  "cluster": {
    "min_tier_in_cluster": 1,
    "max_tier_in_cluster": 2,
    "include_tier3_signal_ids_when_promoted": true
  },
  "baseline": {
    "type": "baseline_identity",
    "tier": 0,
    "title": "Baseline identity on file",
    "preferred_source_order": [
      "registry",
      "regulator",
      "court",
      "layoffs",
      "news",
      "executives",
      "domain",
      "jobs"
    ]
  },
  "fallback_signal_type": {
    "type": "routine_filing",
    "tier": 0,
    "title": "Routine filing",
    "summary": "{source_label} recorded a routine change for {company} on {date}.",
    "match": []
  },
  "signal_types": [
    {
      "type": "insolvency",
      "tier": 1,
      "title": "Insolvency or distress filing",
      "summary": "{source_label} records an insolvency or distress filing for {company} on {date}.",
      "match": [
        {
          "item_types": [
            "insolvency",
            "insolvency_filing",
            "distress_filing",
            "bankruptcy",
            "receivership",
            "winding_up",
            "administration"
          ]
        },
        {
          "item_types": [
            "case"
          ],
          "sources": [
            "court"
          ],
          "item_fields": {
            "status": [
              "stayed",
              "bankruptcy stay",
              "bankruptcy",
              "suspended - bankruptcy",
              "stayed - bankruptcy"
            ]
          }
        }
      ]
    },
    {
      "type": "change_of_control",
      "tier": 1,
      "title": "Ownership change recorded",
      "summary": "{source_label} records a change of ownership or control at {company} on {date}.",
